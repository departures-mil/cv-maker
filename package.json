{
  "name": "cv-maker",
  "productName": "CV Maker",
  "version": "2.1.2",
  "description": "CV Maker",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "node scripts/build.js",
    "eski-kanal": "node tools/eski-kanal.js",
    "ekran": "node tools/ekran.js",
    "test": "node test/datastore.test.js && node --test test/main.smoke.test.js test/eski-kanal.test.js test/cekirdek.test.js test/electron.smoke.test.js",
    "test:electron": "node --test test/electron.smoke.test.js"
  },
  "dependencies": {
    "docx": "^9.14.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  },
  "author": "departures-mil",
  "build": {
    "appId": "com.cvmaker.desktop",
    "productName": "CV Maker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "src/**",
      "cekirdek/**",
      "build/icon.png",
      "release-notes.json",
      "package.json",
      "!**/*.map",
      "!node_modules/pdfjs-dist/{legacy,web,types,image_decoders,lib}/**",
      "!node_modules/pdfjs-dist/build/{pdf.js,pdf.worker.js,pdf.sandbox*,pdf.worker.entry.js}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "compression": "normal",
    "publish": null,
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "CV Maker",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "tr_TR",
        "en_US",
        "ar_SA"
      ],
      "language": "1055",
      "artifactName": "CV-Maker-Setup-${version}.${ext}",
      "uninstallDisplayName": "CV Maker",
      "include": "build/installer.nsh"
    },
    "asar": true
  }
}
