{
  "name": "cv-maker",
  "productName": "CV Maker",
  "version": "2.1.0",
  "description": "CV Maker",
  "main": "boot.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "node scripts/build.js",
    "release": "node scripts/release.js",
    "test": "node test/datastore.test.js && node test/sync.test.js"
  },
  "dependencies": {
    "docx": "^9.14.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  },
  "author": "CV Maker",
  "build": {
    "appId": "com.cvmaker.desktop",
    "productName": "CV Maker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "boot.js",
      "main.js",
      "preload.js",
      "lib/**",
      "src/**",
      "build/icon.png",
      "update-config.json",
      "package.json",
      "!**/*.map",
      "!node_modules/pdfjs-dist/{legacy,web,types,image_decoders,lib}/**",
      "!node_modules/pdfjs-dist/build/{pdf.js,pdf.worker.js,pdf.sandbox*,pdf.worker.entry.js}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "compression": "normal",
    "publish": null,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "CV Maker",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "language": "1055",
      "multiLanguageInstaller": false,
      "artifactName": "CV-Maker-Setup-${version}.${ext}",
      "uninstallDisplayName": "CV Maker",
      "include": "build/installer.nsh"
    }
  },
  "cvmaker": {
    "minShell": "1.3.0",
    "githubRepo": "departures-mil/cv-maker"
  }
}
